# Required — backend API URL
VITE_API_URL=http://localhost:3001/api

# Optional — login/register go through the backend, not the frontend Firebase SDK.
# Fill these only if you add client-side Firebase features later.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qhiro-symbiotic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qhiro-symbiotic
VITE_FIREBASE_DATABASE_URL=https://qhiro-symbiotic-default-rtdb.firebaseio.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
